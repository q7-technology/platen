# Platen's own storage. Not the customer's database — those are added in the app.
DATABASE_URL=postgresql+psycopg://platen:platen@db:5432/platen
REDIS_URL=redis://redis:6379/0

# Used by docker-compose.yml for the db service
POSTGRES_USER=platen
POSTGRES_PASSWORD=platen
POSTGRES_DB=platen

PLATEN_DEBUG=false

# debug | info | warning | error. Defaults to info.
PLATEN_LOG_LEVEL=info

# Host port the API is published on by docker-compose.yml
PLATEN_PORT=8000

# Set when a proxy terminates TLS and does not pass the scheme through.
# Left unset, the session cookie follows the scheme of the request.
# PLATEN_SECURE_COOKIES=true

# The first administrator, made once at startup if there are no users yet.
PLATEN_ADMIN_USERNAME=admin
PLATEN_ADMIN_PASSWORD=change-this-before-you-start
