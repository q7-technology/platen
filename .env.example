# Platen's own storage. Not the customer's database — those are added in the app.
DATABASE_URL=postgresql+psycopg://platen:platen@db:5432/platen
REDIS_URL=redis://redis:6379/0

# Used by docker-compose.yml for the db service
POSTGRES_USER=platen
POSTGRES_PASSWORD=platen
POSTGRES_DB=platen

PLATEN_DEBUG=false

# Host port the API is published on by docker-compose.yml
PLATEN_PORT=8000
